    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet body = (input && input.body !== undefined) ? input.body : input;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { body = {}; } }\nbody = body || {};\nconst topic = (body.topic || '').toString().trim() || 'Untitled';\nconst draft_md = (body.draft_md || '').toString().trim();\nconst words = draft_md.split(/\\s+/).filter(Boolean);\nconst draft_excerpt = words.slice(0, 60).join(' ') + (words.length > 60 ? '…' : '');\nreturn [{ json: { topic, draft_md, draft_excerpt } }];"
      },
      "id": "d0000002-0000-4000-8000-000000000002",
      "name": "Parse Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 300]
    },
    {
      "parameters": {
        "schema": {"__rl": true, "mode": "list", "value": "public"},
        "table": {"__rl": true, "mode": "list", "value": "content_jobs"},
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "topic": "={{ $json.topic }}",
            "branch": "blog",
            "status": "image",
            "draft_md": "={{ $json.draft_md }}",
            "n8n_execution_id": "={{ $execution.id }}"
          }
        },
        "options": {}
      },
      "id": "d0000003-0000-4000-8000-000000000003",
      "name": "Save Job",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [656, 300],
      "credentials": {"postgres": {"id": "5AWMkUroR4Less3r", "name": "Postgres account"}}
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "anthropic-version", "value": "2023-06-01"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"claude-haiku-4-5-20251001\",\"max_tokens\":600,\"system\":\"You are an art director for a content studio. Write a vivid, specific image-generation prompt for a 16:9 blog hero image. Editorial photography or clean illustration. No text, no logos. Include composition cues (subject, lighting, mood, palette). Return JSON only.\",\"messages\":[{\"role\":\"user\",\"content\":{{ JSON.stringify('Topic: ' + $('Parse Input').first().json.topic + '\\n\\nBlog excerpt:\\n' + $('Parse Input').first().json.draft_excerpt + '\\n\\nReturn JSON: { \"prompt\": string (50-150 words), \"style\": string }') }}}]}",
        "options": {}
      },
      "id": "d0000004-0000-4000-8000-000000000004",
      "name": "Claude - Image Prompt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [864, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {"httpHeaderAuth": {"id": "h9HojADDLPyDuAp8", "name": "Header Auth account"}}
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst raw = (res.content && res.content[0] && res.content[0].text) ? res.content[0].text : '';\nlet txt = raw.trim();\nif (txt.startsWith('```')) { txt = txt.substring(txt.indexOf('\\n') + 1); if (txt.endsWith('```')) txt = txt.slice(0, -3); txt = txt.trim(); }\nlet parsed;\ntry { parsed = JSON.parse(txt); } catch (e) { parsed = { prompt: txt, style: '' }; }\nconst job_id = $('Save Job').first().json.id;\nreturn [{ json: { job_id, prompt: parsed.prompt || txt, style: parsed.style || '' } }];"
      },
      "id": "d0000005-0000-4000-8000-000000000005",
      "name": "Parse Image Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1072, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/imagen-4.0-generate-001:predict",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"instances\":[{\"prompt\":{{ JSON.stringify($json.prompt) }}}],\"parameters\":{\"sampleCount\":1,\"aspectRatio\":\"16:9\",\"personGeneration\":\"allow_adult\",\"safetyFilterLevel\":\"block_low_and_above\"}}",
        "options": {}
      },

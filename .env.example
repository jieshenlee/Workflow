# ─────────────────────────────────────────────────────────
# Project Digital — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git. Only commit .env.example.
# ─────────────────────────────────────────────────────────

# ── AI: Content Generation ────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Database: PostgreSQL ──────────────────────────────────
POSTGRES_USER=projectdigital
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_DB=projectdigital

# ── Database: Supabase (alternative to local Postgres) ───
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Inspiration Capture (Telegram bot) ────────────────────
# Message @BotFather on Telegram -> /newbot -> copy the token it gives you.
# This token isn't read from .env by n8n directly - paste it into a
# "Telegram API" credential in the n8n UI and attach it to the
# inspiration-capture workflow's nodes. Kept here so the value lives
# somewhere durable instead of only inside n8n's credential store.
TELEGRAM_BOT_TOKEN=

# ── URL Shortening ────────────────────────────────────────
# Get from: https://dev.bitly.com → Your Apps → Create App
BITLY_ACCESS_TOKEN=

# ── Social Scheduling (Metricool, SaaS) ─────────────────
# Metricool handles channel OAuth on their side - no Docker service to run.
# Connect channels in metricool.com (free tier covers FB / IG / Threads /
# TikTok / YouTube / Pinterest), then for API-based scheduling via n8n:
#   1. Upgrade to a paid plan ($18/mo Starter and up - free tier has no API).
#   2. In Metricool: Settings -> API -> generate a User Token.
#   3. Note your Brand ID from the URL when you open your brand.
# n8n calls https://app.metricool.com/api/... with header X-Mc-Auth = <token>.
#
# If you stay on free, leave these blank and copy/paste captions from the
# dashboard into Metricool's UI manually.
METRICOOL_API_URL=https://app.metricool.com/api
METRICOOL_USER_TOKEN=
METRICOOL_BRAND_ID=

# Sanity CMS - used by the publish-cms workflow
# Get from: https://sanity.io/manage -> project -> API
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
# Public URL of your published site - used to build the blog_url on publish
SITE_URL=https://project-digital-website.vercel.app

# ── File Storage: Cloudflare R2 ───────────────────────────
# Get from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=projectdigital-assets
CLOUDFLARE_R2_PUBLIC_URL=

# ── File Storage: AWS S3 (alternative to R2) ─────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=

# ── n8n Dashboard ────────────────────────────────────────
# Used for the n8n web UI login
N8N_USER=admin
N8N_PASSWORD=changeme_use_a_strong_password
# n8n stores its internal tables in this SEPARATE database (kept
# apart from the app DB so projectdigital stays clean). Default: n8n
N8N_DB=n8n

# ── CMS (add your platform here) ─────────────────────────
# WordPress example:
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Webflow example:
WEBFLOW_API_KEY=
WEBFLOW_SITE_ID=
WEBFLOW_COLLECTION_ID=

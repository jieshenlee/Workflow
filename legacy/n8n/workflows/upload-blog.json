      "maxTries": 2,
      "waitBetweenTries": 3000,
      "credentials": {"httpHeaderAuth": {"id": "v6vqS7OMCUeZLF89", "name": "Header Auth account 2"}}
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst predictions = res.predictions || [];\nconst first = predictions[0] || {};\nconst image_b64 = first.bytesBase64Encoded || '';\nconst mime_type = first.mimeType || 'image/png';\nif (!image_b64) { throw new Error('No image in Gemini response: ' + JSON.stringify(res).slice(0, 500)); }\nconst job_id = $('Parse Image Prompt').first().json.job_id;\nconst prompt = $('Parse Image Prompt').first().json.prompt;\nreturn [{ json: { job_id, prompt, image_b64, mime_type } }];"
      },

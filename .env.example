# ─────────────────────────────────────────────────────────
# Project Digital — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git. Only commit .env.example.
# ─────────────────────────────────────────────────────────

# ── AI: Content Generation ────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Database: Supabase ───────────────────────────────────
# Create a free project at https://supabase.com, then:
#
# Backend (Python API) - Project Settings -> Database -> Connection string ->
# "Session pooler" (works on IPv4 home networks). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Dashboard - Project Settings -> API. The anon key is meant to be public;
# access is enforced by row-level security (db/supabase-rls.sql) plus your
# login. NEVER put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Where the dashboard finds the local Python API (default shown).
# VITE_API_URL=http://localhost:8000

# ── Inspiration Capture (Telegram bot) ────────────────────
# Message @BotFather on Telegram -> /newbot -> copy the token it gives you.
# Share/forward a photo, video or post link to your bot and it's saved to
# /inspiration. No public URL needed (the API polls Telegram).
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to use the bot. Leave empty, message
# the bot once, and it replies with your id to paste here.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── URL Shortening ────────────────────────────────────────
# Not used yet - shortlinks come from keyless TinyURL. Get from:
# https://dev.bitly.com → Your Apps → Create App
BITLY_ACCESS_TOKEN=

# ── Social Scheduling (Metricool, SaaS) ─────────────────
# Metricool handles channel OAuth on their side - no Docker service to run.
# Connect channels in metricool.com (free tier covers FB / IG / Threads /
# TikTok / YouTube / Pinterest), then for API-based scheduling via the backend:
#   1. Upgrade to a paid plan ($18/mo Starter and up - free tier has no API).
#   2. In Metricool: Settings -> API -> generate a User Token.
#   3. Note your Brand ID from the URL when you open your brand.
# The API would call https://app.metricool.com/api/... with header X-Mc-Auth = <token>.
#
# If you stay on free, leave these blank and copy/paste captions from the
# dashboard into Metricool's UI manually.
METRICOOL_API_URL=https://app.metricool.com/api
METRICOOL_USER_TOKEN=
METRICOOL_BRAND_ID=

# Sanity CMS - used by POST /api/publish-cms
# Get from: https://sanity.io/manage -> project -> API
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
# Public URL of your published site - used to build the blog_url on publish
SITE_URL=https://project-digital-website.vercel.app

# ── File Storage: Cloudflare R2 ───────────────────────────
# Get from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=projectdigital-assets
CLOUDFLARE_R2_PUBLIC_URL=

# ── File Storage: AWS S3 (alternative to R2) ─────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
